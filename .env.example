# Church Account credentials used to log in to tos.churchofjesuschrist.org.
# Copy this file to .env (which is gitignored) for local/manual runs, or set
# these as environment variables on the Claude Code environment itself so
# scheduled runs (fresh containers) can pick them up without committing
# secrets to the repo.
CHURCH_USERNAME=
CHURCH_PASSWORD=

# Optional overrides (defaults shown)
# TEMPLE_NAME=Provo City Center Temple
# GROUP_NAME=Tullis, Joshua
# MALE_GUESTS=3
# FEMALE_GUESTS=2
# SESSION_TIME=7:00 AM

# Stops the script right before clicking Submit, so you can verify the whole
# flow without actually creating a reservation.
# DRY_RUN=true

# Show the browser window instead of running headless (useful the first time
# you run this, or if Church Account challenges you with MFA).
# HEADLESS=false
